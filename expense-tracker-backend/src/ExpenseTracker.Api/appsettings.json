{
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "AutoMigrate": false,
    "EnableSensitiveDataLogging": false,
    "CommandTimeoutSeconds": 30
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "GlobalPermitPerMinute": 300
  },
  "Swagger": {
    "Enabled": false
  },
  "Import": {
    "MaxFileSizeBytes": 10485760,
    "MaxRows": 50000
  }
}
