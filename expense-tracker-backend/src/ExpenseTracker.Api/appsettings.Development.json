{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/dev/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=expensetracker_dev;Username=postgres"
  },
  "Jwt": {
    "Issuer": "expensetracker-dev",
    "Audience": "expensetracker-dev-web",
    "SigningKey": "DEV-ONLY-signing-key-change-me-0123456789abcdef"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Database": {
    "AutoMigrate": true,
    "EnableSensitiveDataLogging": true
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 100,
    "GlobalPermitPerMinute": 3000
  },
  "Swagger": {
    "Enabled": true
  }
}
