{
  "Serilog": {
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/prod/api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "shared": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=expensetracker_prod;Username=postgres"
  },
  "Jwt": {
    "Issuer": "expensetracker",
    "Audience": "expensetracker-web"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4300"
    ]
  },
  "Database": {
    "AutoMigrate": false,
    "EnableSensitiveDataLogging": false
  },
  "RateLimiting": {
    "AuthPermitPerMinute": 10,
    "GlobalPermitPerMinute": 300
  },
  "Swagger": {
    "Enabled": false
  }
}
